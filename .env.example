# ——— ATTENTION site env (copy to .env.local) ———

# Public site URL (OG tags, share links). Set on Vercel too.
# Example: https://www.attention.space
NEXT_PUBLIC_SITE_URL=

# Token contract (Robinhood Chain). Leave empty for "Coming soon".
NEXT_PUBLIC_CONTRACT_ADDRESS=

# ——— Optional: mascot voice (ElevenLabs) ———
# Without these, talk mode still works (no premium TTS).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional legacy / unused by default local chat
# XAI_API_KEY=
# XAI_MODEL=grok-4-1-fast-non-reasoning
